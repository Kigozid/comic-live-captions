{
  "name": "comic-captioner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"corepack pnpm --filter @comic-captioner/api dev\" \"corepack pnpm --filter @comic-captioner/web dev\"",
    "build": "corepack pnpm --recursive --if-present build",
    "typecheck": "corepack pnpm --recursive --if-present typecheck && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:visual": "vitest run tests/unit/caption-renderer.visual.test.ts",
    "update:visual-snapshots": "CAPTION_RENDERER_UPDATE_SNAPSHOTS=1 vitest run tests/unit/caption-renderer.snapshot-update.test.ts",
    "test:watch": "vitest",
    "benchmark:ocr": "node --import tsx scripts/benchmark-ocr.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,html,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,html,yml,yaml}\"",
    "models:fetch": "node scripts/fetch-models.mjs",
    "models:fetch:lama": "node scripts/fetch-lama.mjs",
    "lama:serve": "python3 scripts/lama-service.py --port 3040"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "onnxruntime-node": "^1.30.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
